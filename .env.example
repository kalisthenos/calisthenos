BASE_URL=http://localhost:3000
# Adres lokalnego BE (osobne repo, kalisthenos-be) — wymagany. FE zajmuje
# port 3000, więc uruchamiaj BE lokalnie z PORT=3001.
API_URL=http://localhost:3001
# Publiczny adres BE — trafia do HTML-a (`src` obrazków/wideo). Opcjonalny:
# puste tutaj znaczy „taki sam jak API_URL" (patrz app/lib/env.ts). Ustaw
# osobno tylko, gdy BE ma inny adres wewnętrzny i publiczny (np. sieć
# prywatna Railway) — lokalnie jeden adres wystarcza.
API_PUBLIC_URL=
# ADR-0048 (BE): sekret adresu klienta. NA RAILWAY losowy, IDENTYCZNY w FE, API i worker.
# Wartość poniżej to przykład: na produkcji `app/lib/env.ts` odrzuca każdą zaczynającą się od
# `zmien-mnie` — nie zmieniaj tego przedrostka bez zmiany tamtej reguły (pilnuje tego env.test.ts).
CLIENT_FORWARDING_SECRET=zmien-mnie-sekret-przekazywania-min-32-znaki
MAX_UPLOAD_BYTES=250000000
# Osobny limit dla wideo (nagrania serii / demo ćwiczeń). Niższy niż ogólny,
# bo duże nagrania z telefonu zrywają upload (timeout proxy / OOM). W bajtach.
# 30 MB mieści się w 5-min limicie żądań Railway nawet na słabym łączu mobilnym.
# Ostateczne limity i tak egzekwuje BE — te służą wczesnej odmowie.
MAX_VIDEO_UPLOAD_BYTES=30000000
NODE_ENV=development

# Konto trenera dla pętli zrzutów ekranu (`npm run shots`). Samo konto zakłada
# seeder po stronie BE — FE po segmencie S6 nie ma ani bazy, ani seeda.
SEED_TRAINER_EMAIL=trener@example.com
SEED_TRAINER_PASSWORD=replace-me-strong-password

# Czego tu już NIE MA po segmencie S6 (integracja FE↔BE):
#   DATABASE_URL, SESSION_SECRET, FILE_SIGNING_SECRET, DATA_DIR — baza, sesja
#     w tabeli, podpisywanie odnośników i katalog uploadów przeszły do BE;
#   STRIPE_* — płatności wypadły z zakresu (D1 specu, ADR-0024 po stronie BE);
#   GOOGLE_* i CALENDAR_COOKIE_DOMAIN — integracja kalendarza konfiguruje się
#     w całości w `calisthenos-be/.env.example`; FE nie zna sekretów Google.
